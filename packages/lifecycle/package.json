{
  "name": "tealium-prism-lifecycle-react-native",
  "version": "0.1.0",
  "description": "React Native Lifecycle module for Tealium Prism SDK",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "*.podspec",
    "react-native.config.js",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "prepare": "bob build",
    "typecheck": "tsc",
    "lint": "eslint \"**/*.{js,ts,tsx}\""
  },
  "keywords": [
    "react-native",
    "ios",
    "android",
    "tealium",
    "lifecycle"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tealium/tealium-prism-react-native.git"
  },
  "author": "Tealium Inc. <dev@tealium.com> (https://tealium.com)",
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.85.0",
    "tealium-prism-react-native": ">=0.1.0"
  },
  "devDependencies": {
    "@react-native/babel-preset": "0.85.3",
    "@types/react": "^19.2.11",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-builder-bob": "^0.40.17",
    "tealium-prism-react-native": "workspace:*",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "TealiumPrismLifecycleSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.tealiumprismlifecyclereactnative"
    }
  }
}
