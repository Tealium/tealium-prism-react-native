{
  "name": "@tealium/prism-react-native-extensions",
  "version": "0.1.0",
  "description": "Tealium Prism Extensions transformers (SetDataValues, Lowercase, PersistDataValue) for React Native",
  "files": [
    "android",
    "*.podspec",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/.*"
  ],
  "scripts": {
    "clean": "del-cli android/build",
    "prepack": "node -e \"require('fs').copyFileSync('../../LICENSE', 'LICENSE')\"",
    "postpack": "del-cli LICENSE"
  },
  "keywords": [
    "tealium-prism",
    "tealium",
    "prism",
    "react-native",
    "extensions",
    "ios",
    "android"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tealium/tealium-prism-react-native.git"
  },
  "author": "Tealium Inc. <dev@tealium.com> (https://github.com/Tealium)",
  "license": "Commercial",
  "bugs": {
    "url": "https://github.com/Tealium/tealium-prism-react-native/issues"
  },
  "homepage": "https://github.com/Tealium/tealium-prism-react-native#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "peerDependencies": {
    "@tealium/prism-react-native": "^0.1.0",
    "react-native": ">=0.85"
  },
  "devDependencies": {
    "del-cli": "^7.0.0"
  },
  "packageManager": "yarn@4.11.0"
}
