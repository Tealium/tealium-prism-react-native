{
  "core": {
    "log_level": "error",
    "max_queue_size": 100,
    "expiration": 86400,
    "refresh_interval": 900
  },
  "modules": {
    "Trace": {
      "module_type": "Trace",
      "enabled": true,
      "order": 0
    },
    "Lifecycle": {
      "module_type": "Lifecycle",
      "enabled": true,
      "order": 1,
      "rules": "lc-data",
      "configuration": {
        "tracked_lifecycle_events": [
          "launch",
          "wake",
          "sleep"
        ],
        "autotracking_enabled": true,
        "data_target": "allEvents"
      }
    }
  },
  "load_rules": {
    "lc-data": {
      "id": "lc-data",
      "conditions": {
        "variable": {
          "key": "tealium_event"
        },
        "operator": "equals_ignore_case",
        "filter": {
          "value": "lifecycle_data_test"
        }
      }
    }
  },
  "transformations": {
    "Lowercase-1": {
      "transformer_id": "Lowercase",
      "transformation_id": "1",
      "order": 1,
      "scope": "aftercollectors",
      "configuration": {
        "variables": [
          {
            "key": "enabled_modules"
          }
        ]
      },
      "conditions": {
        "variable": {
          "key": "tealium_event"
        },
        "operator": "equals_ignore_case",
        "filter": {
          "value": "lowercase_modules"
        }
      }
    },
    "SetDataValues-2": {
      "transformer_id": "SetDataValues",
      "transformation_id": "2",
      "order": 2,
      "scope": "aftercollectors",
      "configuration": {
        "operations": [
          {
            "input": {
              "key": "tealium_event"
            },
            "destination": {
              "path": "new_values.copied_event"
            }
          }
        ]
      },
      "conditions": {
        "variable": {
          "key": "tealium_event"
        },
        "operator": "equals_ignore_case",
        "filter": {
          "value": "set_copied_event"
        }
      }
    },
    "PersistDataValue-3": {
      "transformer_id": "PersistDataValue",
      "transformation_id": "3",
      "order": 3,
      "scope": "aftercollectors",
      "configuration": {
        "update_policy": "allowupdate",
        "duration": -1,
        "input": {
          "value": "persisted forever (but can be updated)"
        },
        "destination": {
          "path": "persistent.value"
        }
      },
      "conditions": {
        "variable": {
          "key": "tealium_event"
        },
        "operator": "equals_ignore_case",
        "filter": {
          "value": "persist_value"
        }
      }
    },
    "JavaScriptTransformer-4": {
      "transformer_id": "JavaScriptTransformer",
      "transformation_id": "4",
      "order": 4,
      "scope": "aftercollectors",
      "configuration": {
        "js_code": "payload.js_result = payload.enabled_modules.length + ' modules active'"
      },
      "conditions": {
        "variable": {
          "key": "tealium_event"
        },
        "operator": "equals_ignore_case",
        "filter": {
          "value": "js_demo_event"
        }
      }
    },
    "PersistDataValue-5": {
      "transformer_id": "PersistDataValue",
      "transformation_id": "5",
      "order": 5,
      "scope": "aftercollectors",
      "configuration": {
        "update_policy": "keepfirstvalue",
        "duration": 5,
        "input": {
          "value": "persisted for 5 seconds"
        },
        "destination": {
          "path": "data_layer_demo.persisted_value"
        }
      },
      "conditions": {
        "variable": {
          "key": "tealium_event"
        },
        "operator": "equals_ignore_case",
        "filter": {
          "value": "data_layer_demo_event"
        }
      }
    }
  }
}
