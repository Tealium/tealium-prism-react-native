{
  "core": {
    "log_level": "trace",
    "max_queue_size": 100,
    "expiration": 86400,
    "refresh_interval": 900,
    "session_timeout": 1800
  },
  "modules": {
    "AppData": {"module_type": "AppData", "enabled": true},
    "Collect": {"module_type": "Collect", "enabled": true},
    "ConnectivityData": {"module_type": "ConnectivityData", "enabled": true},
    "DataLayer": {"module_type": "DataLayer", "enabled": true},
    "DeepLink": {
      "module_type": "DeepLink",
      "enabled": true,
      "configuration": {"deep_link_trace_enabled": true, "send_deep_link_event": false}
    },
    "DeviceData": {"module_type": "DeviceData", "enabled": true},
    "TealiumData": {"module_type": "TealiumData", "enabled": true},
    "TimeData": {"module_type": "TimeData", "enabled": true},
    "Trace": {"module_type": "Trace", "enabled": true, "configuration": {"track_errors": false}},
    "Lifecycle": {
      "module_type": "Lifecycle",
      "enabled": true,
      "configuration": {
        "autotracking_enabled": true,
        "tracked_lifecycle_events": ["launch", "wake", "sleep"],
        "data_target": "lifecycleEventsOnly"
      }
    },
    "MomentsAPI": {
      "module_type": "MomentsAPI",
      "enabled": true,
      "configuration": {"moments_api_region": "us-east-1"}
    }
  },
  "barriers": {},
  "load_rules": {},
  "transformations": {},
  "consent": null
}
