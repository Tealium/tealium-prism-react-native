{
  "core": {
    "log_level": "error",
    "max_queue_size": 100,
    "expiration": 86400,
    "refresh_interval": 900
  },
  "modules": {
    "Trace": {
      "module_type": "Trace",
      "enabled": true,
      "order": 0
    },
    "Lifecycle": {
      "module_type": "Lifecycle",
      "enabled": true,
      "order": 1,
      "configuration": {
        "tracked_lifecycle_events": [
          "launch",
          "wake",
          "sleep"
        ],
        "autotracking_enabled": true,
        "data_target": "allevents"
      }
    }
  },
  "transformations": {
    "Lowercase-1": {
      "transformer_id": "Lowercase",
      "transformation_id": "1",
      "order": 1,
      "scope": "aftercollectors",
      "configuration": {
        "variables": [
          {
            "key": "enabled_modules"
          }
        ]
      }
    },
    "SetDataValues-2": {
      "transformer_id": "SetDataValues",
      "transformation_id": "2",
      "order": 2,
      "scope": "aftercollectors",
      "configuration": {
        "operations": [
          {
            "input": {
              "key": "tealium_event"
            },
            "destination": {
              "path": "new_values.copied_event"
            }
          }
        ]
      }
    },
    "PersistDataValue-3": {
      "transformer_id": "PersistDataValue",
      "transformation_id": "3",
      "order": 3,
      "scope": "aftercollectors",
      "configuration": {
        "update_policy": "keepfirstvalue",
        "duration": -1,
        "input": {
          "value": "persistence is the key"
        },
        "destination": {
          "path": "persistent.value"
        }
      }
    },
    "JavaScriptTransformer-4": {
      "transformer_id": "JavaScriptTransformer",
      "transformation_id": "4",
      "order": 4,
      "scope": "aftercollectors",
      "configuration": {
        "js_code": "payload.js_result = payload.enabled_modules.reduce((acc, val) => { \nacc = acc + val[0] + 'a' \nreturn acc \n}, '')"
      }
    }
  }
}
