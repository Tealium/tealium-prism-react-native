# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'TealiumPrismReactNativeExample' do
  # Declare the wrapper pod explicitly with its unit test_spec so `pod install`
  # generates a test target in Pods.xcodeproj. This must come before
  # `use_native_modules!`: RN autolinking skips pods already declared here
  # (see react-native/scripts/cocoapods/autolinking.rb), so there's no
  # duplicate declaration and autolinking otherwise links it as usual.
  pod "TealiumPrismReactNative", :path => "../../packages/core", :testspecs => ["Tests"]

  # Without modular headers `pod install` fails with static libraries: the Swift pod
  # FirebaseCoreInternal depends upon GoogleUtilities, which does not define modules.
  pod 'GoogleUtilities', :modular_headers => true

  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Xcode 27 rejects deployment targets below iOS 15, but react_native_post_install raises only
    # the pods' code targets, not their resource bundles (privacy manifests). SQLite.swift (via
    # tealium-prism/Core), GoogleUtilities and nanopb declare iOS 12, PromisesObjC iOS 9.
    # TODO: Remove once react_native_post_install also raises resource bundles, or every pod with
    # a resource bundle declares iOS 15+ (e.g. SQLite.swift 0.17+).
    installer.target_installation_results.pod_target_installation_results.each_value do |result|
      result.resource_bundle_targets.each do |bundle|
        bundle.build_configurations.each do |c|
          current = c.build_settings['IPHONEOS_DEPLOYMENT_TARGET'].to_f
          c.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = [current, min_ios_version_supported.to_f].max.to_s
        end
      end
    end
  end
end
