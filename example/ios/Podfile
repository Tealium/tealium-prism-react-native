ENV['RCT_NEW_ARCH_ENABLED'] = '1'

# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'TealiumPrismReactNativeExample' do
  config = use_native_modules!

  # Tealium Prism SDK - Local development (same layout as Android includeBuild)
  # https://github.com/Tealium/tealium-prism-swift
  # Path: example/ios -> ../.. = repo root -> .. = parent dir -> tealium-prism-swift
  pod 'tealium-prism', :path => '../../../tealium-prism-swift'

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
    
    # Workaround for glog C++ module issues with New Architecture
    # The glog library has module map conflicts when included within C++ namespaces.
    # Solution: Replace glog's module.modulemap with an empty one to prevent module conflicts
    glog_modulemaps = [
      File.join(installer.sandbox.root, 'Target Support Files', 'glog', 'glog.modulemap'),
      File.join(installer.sandbox.root, 'Headers', 'Public', 'glog', 'glog.modulemap')
    ]
    glog_modulemaps.each do |modulemap_path|
      if File.exist?(modulemap_path)
        # Write an empty modulemap to prevent the module from being built
        File.write(modulemap_path, "// Empty modulemap to prevent glog module build issues\n")
        Pod::UI.puts "Emptied #{modulemap_path} to fix New Architecture build"
      end
    end
    
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        # Disable modules for glog target
        if target.name == 'glog'
          config.build_settings['CLANG_ENABLE_MODULES'] = 'NO'
        end
        # For TealiumPrismReactNative, disable modules to avoid glog issues in .mm files
        if target.name == 'TealiumPrismReactNative'
          config.build_settings['CLANG_ENABLE_MODULES'] = 'NO'
        end
        config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
      end
    end
  end
end
