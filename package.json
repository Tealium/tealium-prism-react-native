{
  "name": "tealium-prism-react-native-monorepo",
  "version": "0.1.0",
  "description": "Monorepo for the Tealium Prism React Native packages",
  "private": true,
  "license": "MIT",
  "packageManager": "yarn@4.12.0",
  "workspaces": [
    "packages/*",
    "example"
  ],
  "scripts": {
    "example": "yarn workspace tealium-prism-react-native-example",
    "typecheck": "yarn workspace tealium-prism-react-native typecheck",
    "lint": "yarn workspace tealium-prism-react-native lint",
    "test": "yarn workspace tealium-prism-react-native test",
    "prepare": "yarn workspace tealium-prism-react-native prepare",
    "clean": "del-cli packages/core/lib packages/core/android/build example/android/build example/android/app/build example/ios/build"
  },
  "devDependencies": {
    "del-cli": "^7.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
