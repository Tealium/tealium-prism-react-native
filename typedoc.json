{
  // Add a package path here once that package exports a TypeScript API. Then move
  // `name` to the root, because `packageOptions` applies it to every package.
  "entryPointStrategy": "packages",
  "entryPoints": ["packages/core"],
  "packageOptions": {
    "entryPoints": ["src/index.ts"],
    "name": "Tealium Prism React Native",
    "excludeInternal": true,
    "gitRevision": "main",
    "validation": {
      "notDocumented": true
    }
  },
  // Packages without a TypeScript API can't be entry points, so their READMEs are
  // pulled in as standalone pages through the wrappers in docs/packages.
  "projectDocuments": ["docs/packages/optional-modules.md"],
  "out": "_site",
  "readme": "README.md",
  "treatWarningsAsErrors": true
}
